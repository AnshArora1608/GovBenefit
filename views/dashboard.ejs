<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Citizen Dashboard | GovBenefit</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --ink: #14213d;
            --ink-soft: #3a4a6b;
            --saffron: #e8871e;
            --saffron-dark: #c76d0c;
            --green: #1f7a4d;
            --canvas: #eef1f6;
            --line: #d9dfe9;
            --muted: #5b6678;
        }

        body {
            font-family: "Source Sans 3", system-ui, sans-serif;
            background: var(--canvas);
            color: var(--ink);
            min-height: 100vh;
        }

        h1, h2, h3, h4 {
            font-family: "Bricolage Grotesque", "Source Sans 3", sans-serif;
        }

        .wrap {
            max-width: 1040px;
            margin: 0 auto;
            padding: 28px 16px 64px;
        }

        /* Top Nav */
        .top-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 20px;
            background: #fff;
            border-radius: 14px;
            border: 1px solid var(--line);
            margin-bottom: 24px;
        }
        .brand {
            font-weight: 700;
            font-size: 1.25rem;
            color: var(--ink);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .brand span {
            color: var(--saffron);
        }

        /* Hero */
        .hero {
            background: var(--ink);
            color: #fff;
            border-radius: 18px;
            padding: 28px 32px;
            position: relative;
            overflow: hidden;
            margin-bottom: 24px;
        }
        .hero::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 6px;
            background: linear-gradient(var(--saffron) 0 33%, #fff 33% 66%, var(--green) 66%);
        }
        .hero h1 {
            font-size: 1.85rem;
            margin-bottom: 6px;
        }
        .hero p {
            color: #c3cce0;
            margin: 0;
            font-size: 1rem;
        }

        .btn-hero {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.4);
            color: #fff;
            border-radius: 8px;
            font-weight: 600;
            padding: 7px 16px;
            text-decoration: none;
            font-size: 0.9rem;
        }
        .btn-hero:hover {
            background: #fff;
            color: var(--ink);
        }

        /* Stat cards */
        .stat-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 20px 22px;
            box-shadow: 0 4px 14px rgba(20, 33, 61, 0.04);
            height: 100%;
        }
        .stat-num {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--ink);
            margin-bottom: 2px;
        }
        .stat-label {
            font-size: 0.88rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        /* Section Cards */
        .dash-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 24px 28px;
            box-shadow: 0 6px 20px rgba(20, 33, 61, 0.04);
            margin-bottom: 24px;
        }
        .dash-card h3 {
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* Profile Details Grid */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
            gap: 16px;
        }
        .info-item {
            background: #f8fafd;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 12px 14px;
        }
        .info-k {
            font-size: 0.78rem;
            color: var(--muted);
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 2px;
        }
        .info-v {
            font-size: 0.96rem;
            font-weight: 600;
            color: var(--ink);
            word-break: break-word;
        }

        /* Scheme App Item */
        .app-item {
            border: 1px solid var(--line);
            border-left: 4px solid var(--green);
            background: #ffffff;
            border-radius: 12px;
            padding: 18px 20px;
            margin-bottom: 14px;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            transition: transform .15s ease, box-shadow .15s ease;
        }
        .app-item:hover {
            box-shadow: 0 6px 18px rgba(20, 33, 61, 0.06);
            transform: translateY(-1px);
        }
        .app-title {
            font-size: 1.12rem;
            font-weight: 700;
            color: var(--ink);
            margin: 0 0 4px;
        }
        .app-meta {
            font-size: 0.85rem;
            color: var(--muted);
        }

        .badge-status {
            background: #dff3e8;
            color: var(--green);
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 0.8rem;
            display: inline-block;
        }

        .btn-apply-portal {
            background: var(--saffron);
            color: #1d1203;
            border: 0;
            font-weight: 700;
            border-radius: 9px;
            padding: 8px 18px;
            text-decoration: none;
            font-size: 0.92rem;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-apply-portal:hover {
            background: var(--saffron-dark);
            color: #fff;
        }

        .btn-outline-custom {
            border: 1px solid var(--line);
            background: #fff;
            color: var(--ink);
            font-weight: 600;
            border-radius: 9px;
            padding: 6px 16px;
            text-decoration: none;
            font-size: 0.88rem;
        }
        .btn-outline-custom:hover {
            background: #f1f4f9;
            color: var(--ink);
        }
    </style>
</head>
<body>

<div class="wrap">

    <!-- Top Navigation -->
    <header class="top-nav">
        <a href="/" class="brand">
            🏛️ Gov<span>Benefit</span>
        </a>
        <div class="d-flex gap-2">
            <a href="/recommend" class="btn-outline-custom">🔍 Find Schemes</a>
            <a href="/wishlist" class="btn-outline-custom">⭐ Wishlist</a>
            <a href="/profile" class="btn-outline-custom">✏️ Edit Profile</a>
        </div>
    </header>

    <!-- Hero Header -->
    <section class="hero d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h1>Citizen Dashboard</h1>
            <p>
                <% if (user && user.personal && user.personal.fullName) { %>
                    Welcome back, <strong><%= user.personal.fullName %></strong>! Here are your profile and scheme records.
                <% } else { %>
                    Welcome! Track your saved schemes and profile information.
                <% } %>
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="/profile" class="btn btn-hero">✏️ Update Profile</a>
            <a href="/api/profile/export" class="btn btn-hero">📥 Export JSON</a>
        </div>
    </section>

    <!-- Top Summary Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-num"><%= (applications && applications.length) || 0 %></div>
                <div class="stat-label">Saved Applications</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-num text-success">
                    <%= user ? "100%" : "0%" %>
                </div>
                <div class="stat-label">Profile Completed</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-num" style="font-size:1.35rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                    <%= (user && user.contact && user.contact.state) || "Not Set" %>
                </div>
                <div class="stat-label">Domicile State</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-num" style="font-size:1.35rem; color:var(--saffron-dark);">
                    <%= (user && user.demographics && user.demographics.socialCat) || "General" %>
                </div>
                <div class="stat-label">Category</div>
            </div>
        </div>
    </div>

    <!-- Section 1: Applied / Target Schemes -->
    <section class="dash-card">
        <h3>
            <span>📑 My Scheme Applications &amp; Saved Portals</span>
            <span class="badge bg-light text-dark border fs-6 fw-normal"><%= (applications && applications.length) || 0 %> Recorded</span>
        </h3>

        <% if (!applications || applications.length === 0) { %>
            <div class="text-center py-4 text-muted">
                <div style="font-size: 2.2rem; margin-bottom: 8px;">📂</div>
                <h5>No scheme applications recorded yet</h5>
                <p class="small mb-3">When you click "View &amp; apply" on any recommended scheme, your application record will appear here.</p>
                <a href="/recommend" class="btn btn-sm btn-outline-custom">Explore Recommended Schemes</a>
            </div>
        <% } else { %>
            <div class="app-list">
                <% applications.forEach(function(app) { %>
                    <div class="app-item">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge-status">✓ <%= app.status || "Profile Saved" %></span>
                                <% if (app.appliedAt) { %>
                                    <span class="app-meta">Recorded on <%= new Date(app.appliedAt).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                                <% } %>
                            </div>
                            <h4 class="app-title"><%= app.scheme_name %></h4>
                            <% if (app.scheme_url) { %>
                                <div class="app-meta text-truncate" style="max-width: 520px;">
                                    Official Portal: <a href="<%= app.scheme_url %>" target="_blank" rel="noopener noreferrer"><%= app.scheme_url %></a>
                                </div>
                            <% } %>
                        </div>

                        <div>
                            <% if (app.scheme_url) { %>
                                <a href="<%= app.scheme_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-apply-portal">
                                    Proceed to Official Portal ↗
                                </a>
                            <% } else { %>
                                <span class="text-muted small">No direct URL recorded</span>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </section>

    <!-- Section 2: Saved Citizen Profile Details -->
    <% if (user) { %>
    <section class="dash-card">
        <h3>
            <span>👤 Saved Profile Details</span>
            <a href="/profile" class="btn btn-sm btn-outline-custom">Edit Details</a>
        </h3>

        <!-- Personal & Contact -->
        <h5 class="fw-bold text-muted small text-uppercase mb-2">Personal &amp; Contact Information</h5>
        <div class="info-grid mb-4">
            <div class="info-item">
                <div class="info-k">Full Name</div>
                <div class="info-v"><%= (user.personal && user.personal.fullName) || "-" %></div>
            </div>
            <div class="info-item">
                <div class="info-k">Father/Guardian</div>
                <div class="info-v"><%= (user.personal && user.personal.guardianName) || "-" %></div>
            </div>
            <div class="info-item">
                <div class="info-k">Age &amp; Gender</div>
                <div class="info-v"><%= (user.personal && user.personal.age) || "-" %> yrs / <%= (user.personal && user.personal.gender) || "-" %></div>
            </div>
            <div class="info-item">
                <div class="info-k">Mobile Number</div>
                <div class="info-v"><%= (user.contact && user.contact.mobile) || "-" %></div>
            </div>
            <div class="info-item">
                <div class="info-k">Email</div>
                <div class="info-v"><%= (user.contact && user.contact.email) || "-" %></div>
            </div>
            <div class="info-item">
                <div class="info-k">State &amp; District</div>
                <div class="info-v"><%= (user.contact && user.contact.state) || "-" %><%= user.contact && user.contact.district ? ', ' + user.contact.district : '' %></div>
            </div>
            <div class="info-item">
                <div class="info-k">PIN Code</div>
                <div class="info-v"><%= (user.contact && user.contact.pincode) || "-" %> (<%= (user.contact && user.contact.areaType) || "Rural" %>)</div>
            </div>
            <div class="info-item">
                <div class="info-k">Full Address</div>
                <div class="info-v"><%= (user.contact && user.contact.address) || "-" %></div>
            </div>
        </div>

        <!-- Demographics & Eligibility -->
        <h5 class="fw-bold text-muted small text-uppercase mb-2">Social Category &amp; Status</h5>
        <div class="info-grid mb-4">
            <div class="info-item">
                <div class="info-k">Social Category</div>
                <div class="info-v"><%= (user.demographics && user.demographics.socialCat) || "General" %></div>
            </div>
            <div class="info-item">
                <div class="info-k">Minority Status</div>
                <div class="info-v"><%= user.demographics && user.demographics.minority ? 'Yes (' + (user.demographics.minorityCommunity || 'Minority') + ')' : 'No' %></div>
            </div>
            <div class="info-item">
                <div class="info-k">Differently Abled (PwD)</div>
                <div class="info-v"><%= user.demographics && user.demographics.disability ? 'Yes (' + (user.demographics.disabilityType || 'PwD') + ')' : 'No' %></div>
            </div>
            <div class="info-item">
                <div class="info-k">BPL / Ration Card</div>
                <div class="info-v"><%= user.demographics && user.demographics.bpl ? 'Yes (' + (user.demographics.rationCardNo || 'BPL') + ')' : 'No' %></div>
            </div>
        </div>

        <!-- Education, Occupation & Bank -->
        <h5 class="fw-bold text-muted small text-uppercase mb-2">Employment, Income &amp; Bank Identity</h5>
        <div class="info-grid">
            <div class="info-item">
                <div class="info-k">Education</div>
                <div class="info-v"><%= (user.educationOccupation && user.educationOccupation.education) || "-" %></div>
            </div>
            <div class="info-item">
                <div class="info-k">Occupation</div>
                <div class="info-v"><%= (user.educationOccupation && user.educationOccupation.occupation) || "-" %></div>
            </div>
            <div class="info-item">
                <div class="info-k">Family Income</div>
                <div class="info-v">₹ <%= Number((user.educationOccupation && user.educationOccupation.income) || 0).toLocaleString("en-IN") %> / year</div>
            </div>
            <div class="info-item">
                <div class="info-k">Aadhaar (ID)</div>
                <div class="info-v">
                    <% if (user.bankIdentity && user.bankIdentity.aadhaarNo) { %>
                        •••• •••• <%= user.bankIdentity.aadhaarNo.slice(-4) %>
                    <% } else { %>
                        Not Provided
                    <% } %>
                </div>
            </div>
            <div class="info-item">
                <div class="info-k">Bank Account</div>
                <div class="info-v"><%= (user.bankIdentity && user.bankIdentity.bankName) || "Bank" %> (<%= (user.bankIdentity && user.bankIdentity.ifscCode) || "IFSC" %>)</div>
            </div>
            <div class="info-item">
                <div class="info-k">Account Number</div>
                <div class="info-v"><%= (user.bankIdentity && user.bankIdentity.accountNo) || "-" %></div>
            </div>
        </div>

        <% if (lastUpdated) { %>
            <div class="mt-3 text-muted small text-end">
                Last updated on: <%= new Date(lastUpdated).toLocaleString("en-IN") %>
            </div>
        <% } %>
    </section>
    <% } %>

</div>

</body>
</html>
