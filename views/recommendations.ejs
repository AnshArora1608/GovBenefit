
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Recommended Government Schemes</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            background: #f5f7fb;
        }

        .container {
            max-width: 1100px;
            margin: 50px auto;
        }

        .scheme-card {
            background: white;
            border-radius: 14px;
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.07);
        }

        .scheme-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .badge {
            margin-right: 6px;
        }

        .score {
            font-weight: 600;
        }

        .apply-btn {
            margin-top: 15px;
        }
    </style>
</head>

<body>

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Recommended Schemes</h2>
            <p class="text-muted">
                Government schemes matched to your profile
            </p>
        </div>

        <a href="/recommend" class="btn btn-outline-primary">
            Search Again
        </a>
    </div>

    <% if (!recommendations || recommendations.length === 0) { %>

        <div class="alert alert-warning">
            No suitable schemes were found for your profile.
        </div>

    <% } else { %>

        <% recommendations.forEach((scheme, index) => { %>

            <div class="scheme-card">

                <div class="scheme-title">
                    <%= index + 1 %>. <%= scheme.scheme_name %>
                </div>

                <div class="mb-3">

                    <span class="badge bg-primary">
                        <%= scheme.level %>
                    </span>

                    <span class="badge bg-secondary">
                        <%= scheme.benefit_type %>
                    </span>

                    <span class="badge bg-info text-dark">
                        <%= scheme.app_mode %>
                    </span>

                </div>

                <p class="mb-2">
                    <strong>State:</strong>
                    <%= scheme.state %>
                </p>

                <p class="mb-2">
                    <strong>Match Score:</strong>
                    <span class="score">
                        <%= Number(scheme.score).toFixed(2) %>%
                    </span>
                </p>

                <a
                    href="<%= scheme.source_url %>"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary apply-btn"
                >
                    View Scheme
                </a>

            </div>

        <% }) %>

    <% } %>

</div>

</body>
</html>

