<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PMEGP e-Portal | Online Application Form for Individual</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/extension/mentor.css">

    <style>
        :root {
            --gov-blue: #0b3c6d;
            --gov-dark: #062340;
            --gov-gold: #ff9933;
            --gov-bg: #f4f6f9;
            --gov-border: #b0c4de;
        }

        body {
            font-family: "Source Sans 3", Arial, sans-serif;
            background-color: var(--gov-bg);
            color: #222;
            margin: 0;
            padding: 0;
        }

        /* Official Gov Header */
        .portal-header {
            background: linear-gradient(to right, #002244, #0b3c6d);
            color: #fff;
            padding: 16px 24px;
            border-bottom: 4px solid var(--gov-gold);
        }
        .emblem-title {
            font-size: 1.1rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            margin: 0;
            text-transform: uppercase;
        }
        .portal-subtitle {
            font-size: 0.85rem;
            color: #cbd5e1;
            margin: 0;
        }

        .portal-container {
            max-width: 1060px;
            margin: 24px auto 60px;
            background: #fff;
            border: 1px solid var(--gov-border);
            border-radius: 6px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.06);
            overflow: hidden;
        }

        .form-banner {
            background: #e9eff7;
            border-bottom: 2px solid #0b3c6d;
            padding: 14px 20px;
            font-weight: 700;
            font-size: 1.15rem;
            color: #0b3c6d;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .instructions-box {
            background: #fffdf0;
            border-left: 4px solid #f59e0b;
            padding: 12px 18px;
            margin: 16px 20px;
            font-size: 0.88rem;
            color: #78350f;
            border-radius: 4px;
        }

        .form-section-title {
            background: #0b3c6d;
            color: #fff;
            padding: 8px 14px;
            font-size: 0.95rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-top: 24px;
            margin-bottom: 16px;
            border-radius: 4px;
        }

        .form-label {
            font-weight: 600;
            font-size: 0.88rem;
            color: #1e293b;
            margin-bottom: 4px;
        }
        .req-star {
            color: #dc2626;
            font-weight: bold;
        }

        .form-control, .form-select {
            font-size: 0.9rem;
            border: 1px solid #94a3b8;
            border-radius: 4px;
            padding: 7px 10px;
        }
        .form-control:focus, .form-select:focus {
            border-color: #0b3c6d;
            box-shadow: 0 0 0 3px rgba(11, 60, 109, 0.2);
        }

        /* CAPTCHA Box */
        .captcha-card {
            background: #f8fafc;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            padding: 16px;
            margin-top: 20px;
        }
        .captcha-img {
            background: #e2e8f0;
            border: 1px dashed #64748b;
            font-family: monospace;
            font-weight: bold;
            font-size: 1.4rem;
            letter-spacing: 8px;
            padding: 8px 20px;
            display: inline-block;
            user-select: none;
            color: #1e293b;
            text-decoration: line-through;
        }

        /* Declaration Box */
        .declaration-card {
            background: #f1f5f9;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            padding: 16px;
            margin-top: 20px;
            font-size: 0.86rem;
            color: #334155;
        }

        .btn-gov-submit {
            background: #15803d;
            color: #fff;
            font-weight: 700;
            font-size: 1rem;
            padding: 10px 32px;
            border: 0;
            border-radius: 4px;
        }
        .btn-gov-submit:hover {
            background: #166534;
            color: #fff;
        }

        /* Floating test extension trigger button */
        .mentor-extension-pill {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: #14213d;
            color: #fff;
            border: 2px solid #e8871e;
            box-shadow: 0 8px 24px rgba(0,0,0,0.25);
            border-radius: 50px;
            padding: 10px 20px;
            font-size: 0.92rem;
            font-weight: 700;
            cursor: pointer;
            z-index: 99999;
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }
        .mentor-extension-pill:hover {
            background: #0b3c6d;
            color: #fff;
            transform: translateY(-2px);
        }
    </style>
</head>
<body>

    <!-- Official Government Header -->
    <header class="portal-header">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h1 class="emblem-title">🇮🇳 Khadi and Village Industries Commission (KVIC)</h1>
                <p class="portal-subtitle">Ministry of Micro, Small and Medium Enterprises, Government of India</p>
            </div>
            <div class="text-end d-none d-md-block">
                <span class="badge bg-warning text-dark px-3 py-2 fw-bold">PMEGP e-Portal v2.4</span>
            </div>
        </div>
    </header>

    <div class="portal-container">
        <div class="form-banner">
            <span>Online Application Form for Individual (PMEGP Score Card 100 Points)</span>
            <span class="badge bg-primary">Citizen Application</span>
        </div>

        <div class="instructions-box">
            <strong>Important Guidelines:</strong> Please ensure that all information entered matches your Aadhaar Card and Bank Passbook records. Fields marked with <span class="req-star">*</span> are mandatory.
        </div>

        <form id="pmegp_application_form" class="px-4 pb-4" onsubmit="event.preventDefault(); alert('Application submitted successfully! Application Reference No: PMEGP/2026/' + Math.floor(100000 + Math.random()*900000));">

            <!-- Section 1: Identification & Agency -->
            <div class="form-section-title">1. Applicant Identification &amp; Implementing Agency</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="aadhaar_no" class="form-label">1. Aadhaar Card Number (आधार संख्या) <span class="req-star">*</span></label>
                    <input type="text" class="form-control" id="aadhaar_no" name="aadhaar_no" maxlength="12" placeholder="Enter 12 digits UID" required>
                </div>

                <div class="col-md-6">
                    <label for="applicant_name" class="form-label">2. Name of Applicant (आवेदक का नाम) <span class="req-star">*</span></label>
                    <input type="text" class="form-control" id="applicant_name" name="applicant_name" placeholder="As written in Aadhaar" required>
                </div>

                <div class="col-md-6">
                    <label for="sponsoring_agency" class="form-label">3. Sponsoring Agency (प्रायोजक एजेंसी) <span class="req-star">*</span></label>
                    <select class="form-select" id="sponsoring_agency" name="sponsoring_agency" required>
                        <option value="">-- Select Agency --</option>
                        <option value="KVIC">KVIC (Khadi and Village Industries Commission)</option>
                        <option value="KVIB">KVIB (State Khadi &amp; Village Industries Board)</option>
                        <option value="DIC">DIC (District Industries Centre)</option>
                        <option value="COIR">Coir Board</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label for="legal_type" class="form-label">4. Legal Type / Constitution (कानूनी प्रारूप) <span class="req-star">*</span></label>
                    <select class="form-select" id="legal_type" name="legal_type" required>
                        <option value="">-- Select Legal Type --</option>
                        <option value="Individual" selected>Individual (व्यक्तिगत)</option>
                        <option value="SHG">Self Help Group (SHG)</option>
                        <option value="Trust">Trust / Society</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label for="state" class="form-label">5. State / Union Territory (राज्य) <span class="req-star">*</span></label>
                    <select class="form-select" id="state" name="state" required>
                        <option value="">-- Select State --</option>
                        <option value="Rajasthan">Rajasthan</option>
                        <option value="Maharashtra">Maharashtra</option>
                        <option value="Uttar Pradesh">Uttar Pradesh</option>
                        <option value="Madhya Pradesh">Madhya Pradesh</option>
                        <option value="Delhi">Delhi</option>
                        <option value="Gujarat">Gujarat</option>
                        <option value="Karnataka">Karnataka</option>
                        <option value="Tamil Nadu">Tamil Nadu</option>
                        <option value="Bihar">Bihar</option>
                        <option value="Haryana">Haryana</option>
                        <option value="Punjab">Punjab</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label for="district" class="form-label">6. District (जिला) <span class="req-star">*</span></label>
                    <input type="text" class="form-control" id="district" name="district" placeholder="District name where unit is established" required>
                </div>
            </div>

            <!-- Section 2: Social Category & Demographics -->
            <div class="form-section-title">2. Social Category &amp; Personal Demographics</div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label for="gender" class="form-label">7. Gender (लिंग) <span class="req-star">*</span></label>
                    <select class="form-select" id="gender" name="gender" required>
                        <option value="">-- Select Gender --</option>
                        <option value="male">Male (पुरुष)</option>
                        <option value="female">Female (महिला)</option>
                        <option value="transgender">Transgender (ट्रांसजेंडर)</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="social_cat" class="form-label">8. Social Category (सामाजिक श्रेणी) <span class="req-star">*</span></label>
                    <select class="form-select" id="social_cat" name="social_cat" required>
                        <option value="">-- Select Social Category --</option>
                        <option value="General">General (सामान्य)</option>
                        <option value="OBC">OBC (Other Backward Class)</option>
                        <option value="SC">SC (Scheduled Caste)</option>
                        <option value="ST">ST (Scheduled Tribe)</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="special_cat" class="form-label">9. Special Category (विशेष श्रेणी) <span class="req-star">*</span></label>
                    <select class="form-select" id="special_cat" name="special_cat" required>
                        <option value="None">None (कोई नहीं)</option>
                        <option value="PH">Physically Handicapped (दिव्यांग)</option>
                        <option value="Ex-Servicemen">Ex-Servicemen (पूर्व सैनिक)</option>
                        <option value="Hill/Border">Hill / Border Area</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="dob" class="form-label">10. Date of Birth (जन्म तिथि) <span class="req-star">*</span></label>
                    <input type="date" class="form-control" id="dob" name="dob" required>
                </div>

                <div class="col-md-4">
                    <label for="qualification" class="form-label">11. Academic Qualification (शैक्षणिक योग्यता) <span class="req-star">*</span></label>
                    <select class="form-select" id="qualification" name="qualification" required>
                        <option value="">-- Select Qualification --</option>
                        <option value="Under 8th">Under 8th Pass</option>
                        <option value="8th Pass">8th Pass</option>
                        <option value="10th Pass">10th Pass / Matriculation</option>
                        <option value="12th Pass">12th Pass / Intermediate</option>
                        <option value="Graduate">Graduate / Degree Holder</option>
                        <option value="Post Graduate">Post Graduate</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="edp_training" class="form-label">12. EDP Training Undergone? (प्रशिक्षण)</label>
                    <select class="form-select" id="edp_training" name="edp_training">
                        <option value="No">No (नहीं)</option>
                        <option value="Yes">Yes (हाँ)</option>
                    </select>
                </div>
            </div>

            <!-- Section 3: Contact Details -->
            <div class="form-section-title">3. Communication &amp; Contact Details</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="mobile_no" class="form-label">13. Mobile Number (मोबाइल नंबर) <span class="req-star">*</span></label>
                    <input type="tel" class="form-control" id="mobile_no" name="mobile_no" pattern="[0-9]{10}" maxlength="10" placeholder="10-digit mobile number" required>
                </div>

                <div class="col-md-6">
                    <label for="email" class="form-label">14. Email ID (ईमेल आईडी)</label>
                    <input type="email" class="form-control" id="email" name="email" placeholder="applicant@domain.com">
                </div>

                <div class="col-12">
                    <label for="comm_address" class="form-label">15. Communication Address (पत्र व्यवहार का पता) <span class="req-star">*</span></label>
                    <textarea class="form-control" id="comm_address" name="comm_address" rows="2" placeholder="Full postal address with locality" required></textarea>
                </div>
            </div>

            <!-- Section 4: Bank Details -->
            <div class="form-section-title">4. Financial &amp; Bank Account Details</div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label for="pan_no" class="form-label">16. PAN Card Number (पैन संख्या)</label>
                    <input type="text" class="form-control" id="pan_no" name="pan_no" maxlength="10" placeholder="e.g. ABCDE1234F" style="text-transform:uppercase;">
                </div>

                <div class="col-md-4">
                    <label for="bank_account_no" class="form-label">17. Savings Bank Account No. (बैंक खाता संख्या) <span class="req-star">*</span></label>
                    <input type="text" class="form-control" id="bank_account_no" name="bank_account_no" placeholder="Enter bank account number" required>
                </div>

                <div class="col-md-4">
                    <label for="ifsc_code" class="form-label">18. Bank Branch IFSC Code (आईएफएससी कोड) <span class="req-star">*</span></label>
                    <input type="text" class="form-control" id="ifsc_code" name="ifsc_code" maxlength="11" placeholder="e.g. SBIN0001234" style="text-transform:uppercase;" required>
                </div>
            </div>

            <!-- Section 5: Human Action Security & Declaration -->
            <div class="form-section-title">5. Verification &amp; Undertaking</div>

            <!-- CAPTCHA (Human Action Required) -->
            <div class="captcha-card">
                <label for="captcha_code" class="form-label fw-bold">19. Security Code / CAPTCHA Verification <span class="req-star">*</span></label>
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="captcha-img" id="captchaBox">7X9K2P</div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="document.getElementById('captchaBox').textContent = Math.random().toString(36).substring(2, 8).toUpperCase();">↻ Refresh</button>
                </div>
                <div style="max-width: 260px;">
                    <input type="text" class="form-control" id="captcha_code" name="captcha_code" placeholder="Enter code shown above" required>
                </div>
                <div class="form-text text-muted">Please type the characters displayed in the security box manually.</div>
            </div>

            <!-- Declaration Checkbox (Human Action Required) -->
            <div class="declaration-card">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="declaration_check" name="declaration_check" required>
                    <label class="form-check-label fw-bold" for="declaration_check">
                        20. Applicant Declaration &amp; Legal Undertaking <span class="req-star">*</span>
                    </label>
                </div>
                <div class="small mt-2 text-secondary">
                    I hereby declare that all information furnished above is true and correct to the best of my knowledge. I have not availed any credit-linked margin money subsidy under PMEGP or REGP or PMRY or any other central/state government scheme previously. If any information is found incorrect, my application and sanctioned subsidy may be revoked and recovered.
                </div>
            </div>

            <!-- Final Submission (Human Action Required) -->
            <div class="text-center mt-4">
                <button type="submit" class="btn btn-gov-submit" id="submit_btn">
                    💾 Save &amp; Submit Application Data
                </button>
                <div class="small text-muted mt-2">
                    Only click after physically verifying all entered information and documents.
                </div>
            </div>

        </form>
    </div>

    <!-- Built-in direct Form Mentor test badge -->
    <a href="javascript:void(0)" class="mentor-extension-pill" id="launchMentorDemoBtn" title="Test GovBenefit Form Mentor">
        🛡️ GovBenefit Form Mentor
    </a>

    <!-- Form Mentor Script -->
    <script src="/extension/content.js"></script>
</body>
</html>
