<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Wishlist | Government Schemes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root { --ink:#14213d; --ink-soft:#3a4a6b; --saffron:#e8871e; --saffron-dark:#c76d0c; --green:#1f7a4d; --canvas:#eef1f6; --line:#d9dfe9; --muted:#5b6678; }
        body { font-family:"Source Sans 3",system-ui,sans-serif; background:var(--canvas); color:var(--ink); }
        h1,h2,h3 { font-family:"Bricolage Grotesque","Source Sans 3",sans-serif; }
        .wrap { max-width:900px; margin:0 auto; padding:32px 16px 60px; }
        .hero { background:var(--ink); color:#fff; border-radius:20px; padding:28px 32px; position:relative; overflow:hidden; }
        .hero::before { content:""; position:absolute; left:0; top:0; bottom:0; width:6px; background:linear-gradient(var(--saffron) 0 33%,#fff 33% 66%,var(--green) 66%); }
        .hero h1 { font-size:1.8rem; margin-bottom:6px; } .hero p { color:#c3cce0; margin:0; }
        .btn-hero { background:transparent; border:1px solid rgba(255,255,255,.4); color:#fff; border-radius:10px; font-weight:600; }
        .btn-hero:hover { background:#fff; color:var(--ink); }
        .card-w { background:#fff; border:1px solid var(--line); border-radius:16px; padding:20px 22px; margin-top:16px; }
        .card-w.updated { border-color:var(--saffron); box-shadow:0 10px 28px rgba(232,135,30,.16); }
        .card-w h2 { font-size:1.15rem; font-weight:700; margin:0 0 6px; }
        .tag { display:inline-block; border-radius:6px; padding:3px 10px; font-size:.8rem; font-weight:600; margin:0 6px 6px 0; background:#e7ecf6; color:var(--ink-soft); }
        .tag.new { background:var(--saffron); color:#1d1203; } .tag.ok { background:#dff3e8; color:var(--green); } .tag.upcoming { background:#e3ecfb; color:#1d4ea3; } .tag.err { background:#eceff4; color:var(--muted); }
        .meta { color:var(--muted); font-size:.9rem; }
        .circ { margin:10px 0 0; padding-left:18px; font-size:.92rem; } .circ a { color:var(--ink-soft); }
        .btn-apply { background:var(--saffron); color:#1d1203; border:0; font-weight:700; border-radius:10px; padding:8px 18px; }
        .btn-apply:hover { background:var(--saffron-dark); color:#fff; }
        .btn-soft { border:1px solid var(--line); background:#fff; color:var(--ink-soft); border-radius:10px; font-weight:600; }
        .btn-soft:hover { border-color:var(--saffron); color:var(--ink); }
        .notify { background:#fff4e6; border:1px solid var(--saffron); border-radius:16px; padding:18px 22px; margin-top:20px; }
        .form-control { border-radius:10px; } .form-control:focus { border-color:var(--saffron); box-shadow:0 0 0 .2rem rgba(232,135,30,.22); }
    </style>
</head>
<body>
<div class="wrap">
    <section class="hero">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h1>My wishlist</h1>
                <p>Schemes you saved for later. We watch their official pages for new circulars.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/dashboard" class="btn btn-hero">Dashboard</a>
                <a href="/recommend" class="btn btn-hero">Find more schemes</a>
            </div>
        </div>
    </section>

    <section class="notify" id="notifyBox" hidden>
        <h2 class="h5 mb-1">Get email alerts</h2>
        <p class="meta mb-3">Enter your email. We will mail you when a saved scheme publishes a new circular, and 7 days before its last date.</p>
        <div class="d-flex flex-wrap gap-2">
            <input type="email" id="email" class="form-control" style="max-width:320px" placeholder="you@example.com" aria-label="Email address">
            <button class="btn btn-apply" id="subBtn">Notify me</button>
        </div>
        <div class="meta mt-2" id="subMsg" aria-live="polite"></div>
    </section>

    <div id="list"></div>
    <p class="meta text-center mt-4">Your wishlist is saved on this device. No login needed. Always confirm details on the official website.</p>
</div>

<script>
(function () {
    var KEY = "schemeWishlist", status = {};
    function read() { try { return JSON.parse(localStorage.getItem(KEY)) || []; } catch (e) { return []; } }
    function write(a) { try { localStorage.setItem(KEY, JSON.stringify(a)); } catch (e) {} }
    function el(tag, cls, text) { var n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; }
    function ago(ms) {
        if (!ms) return "never";
        var m = Math.round((Date.now() - ms) / 60000);
        if (m < 2) return "just now"; if (m < 60) return m + " min ago";
        var h = Math.round(m / 60); if (h < 24) return h + " hr ago";
        return Math.round(h / 24) + " days ago";
    }

    function dayDiff(iso) {
        var n = new Date(), t = Date.UTC(n.getFullYear(), n.getMonth(), n.getDate());
        return Math.round((Date.parse(iso + "T00:00:00Z") - t) / 864e5);
    }
    function pl(n, w) { return n + " " + w + (n === 1 ? "" : "s"); }
    function fmtDate(iso) { return new Date(iso + "T00:00:00Z").toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }); }
    function deadline(it) {
        if (it.start && dayDiff(it.start) > 0) return { text: "Opens " + fmtDate(it.start) + " (in " + pl(dayDiff(it.start), "day") + ")", cls: "tag upcoming" };
        if (!it.end) return null;
        var d = dayDiff(it.end);
        if (d < 0) return { text: "Closed on " + fmtDate(it.end), cls: "tag err" };
        if (d <= 15) return { text: d === 0 ? "Closes today" : "Closes in " + pl(d, "day") + " (" + fmtDate(it.end) + ")", cls: "tag new" };
        return { text: "Closes " + fmtDate(it.end) + " (in " + pl(d, "day") + ")", cls: "tag ok" };
    }
    function urgency(it) { return it.end && dayDiff(it.end) >= 0 ? dayDiff(it.end) : 99999; }

    function render() {
        var items = read().sort(function (a, b) { return urgency(a) - urgency(b); }), box = document.getElementById("list");
        box.innerHTML = "";
        document.getElementById("notifyBox").hidden = items.length === 0;

        if (!items.length) {
            var e = el("div", "card-w text-center py-5");
            e.appendChild(el("h2", "h4", "Your wishlist is empty"));
            e.appendChild(el("p", "meta", "Tap \"Remind me later\" on any scheme you cannot apply to right now."));
            var a = el("a", "btn btn-apply", "Find schemes"); a.href = "/recommend"; e.appendChild(a);
            box.appendChild(e); return;
        }

        items.forEach(function (it) {
            var st = status[it.url];
            var changed = !!(st && st.hash && it.seenHash && st.hash !== it.seenHash);
            var c = el("article", "card-w" + (changed ? " updated" : ""));
            var tags = el("div");
            if (changed) tags.appendChild(el("span", "tag new", "New update"));
            else if (st && st.error && !st.hash) tags.appendChild(el("span", "tag err", "Could not check right now"));
            else if (st) tags.appendChild(el("span", "tag ok", "No new update"));
            else tags.appendChild(el("span", "tag err", "Checking..."));
            var dl = deadline(it);
            if (dl) tags.appendChild(el("span", dl.cls, dl.text));
            if (it.level) tags.appendChild(el("span", "tag", it.level));
            if (it.type) tags.appendChild(el("span", "tag", it.type));
            c.appendChild(tags);
            c.appendChild(el("h2", null, it.name));
            c.appendChild(el("div", "meta", "Saved " + ago(it.savedAt) + (st ? "  |  Last checked " + ago(st.checkedAt) : "")));

            if (st && st.circulars && st.circulars.length) {
                c.appendChild(el("div", "meta mt-2", "Latest circulars found on the page:"));
                var ul = el("ul", "circ");
                st.circulars.slice(0, 3).forEach(function (x) {
                    var li = el("li"), l = el("a", null, x.text);
                    l.href = x.href; l.target = "_blank"; l.rel = "noopener noreferrer";
                    li.appendChild(l); ul.appendChild(li);
                });
                c.appendChild(ul);
            }

            var row = el("div", "d-flex flex-wrap gap-2 mt-3");
            var open = el("a", "btn btn-apply", "Open official page");
            open.href = it.url; open.target = "_blank"; open.rel = "noopener noreferrer"; row.appendChild(open);
            if (changed) {
                var seen = el("button", "btn btn-soft", "Mark as seen");
                seen.onclick = function () { it.seenHash = st.hash; write(items); render(); };
                row.appendChild(seen);
            }
            var rm = el("button", "btn btn-soft", "Remove");
            rm.onclick = function () { write(read().filter(function (x) { return x.id !== it.id; })); render(); };
            row.appendChild(rm);
            c.appendChild(row);
            box.appendChild(c);
        });
    }

    function load() {
        var items = read(), urls = items.map(function (i) { return i.url; }).filter(Boolean);
        render();
        if (!urls.length) return;
        fetch("/api/wishlist/status", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ urls: urls }) })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                status = data || {};
                items.forEach(function (it) { if (!it.seenHash && status[it.url] && status[it.url].hash) it.seenHash = status[it.url].hash; });
                write(items); render();
            }).catch(function () { render(); });
    }

    var emailBox = document.getElementById("email");
    try { emailBox.value = localStorage.getItem("schemeEmail") || ""; } catch (e) {}
    document.getElementById("subBtn").onclick = function () {
        var msg = document.getElementById("subMsg");
        var items = read().filter(function (i) { return i.url; }).map(function (i) { return { url: i.url, name: i.name, end: i.end || null }; });
        fetch("/api/wishlist/subscribe", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: emailBox.value.trim(), items: items }) })
            .then(function (r) { return r.json().then(function (j) { return { ok: r.ok && j.ok }; }); })
            .then(function (res) {
                msg.textContent = res.ok ? "Done. We will email you when a saved scheme has a new circular." : "Please enter a valid email address.";
                if (res.ok) { try { localStorage.setItem("schemeEmail", emailBox.value.trim()); } catch (e) {} }
            }).catch(function () { msg.textContent = "Something went wrong. Please try again."; });
    };

    load();
})();
</script>
</body>
</html>
